#!/bin/sh
# OPSEC guardrail: scan the commit message for addresses, hostnames and secrets.
root=$(git rev-parse --show-toplevel) || exit 1
for py in python3 python py; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 8))' 2>/dev/null; then
    exec "$py" "$root/scripts/opsec_scan.py" --message "$1"
  fi
done
echo "opsec: Python 3.8+ not found; refusing to commit unscanned changes" >&2
exit 1
