# Argus SOC — environment template
# Copy to .env and fill in locally. .env is git-ignored; never commit real values.

# --- AI triage (Claude API)
ANTHROPIC_API_KEY=

# --- Operator alerting (Telegram bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Escalation (PagerDuty Events API v2)
PAGERDUTY_ROUTING_KEY=
PAGERDUTY_EVENTS_URL=

# --- Workflow engine (n8n)
N8N_HOST=
N8N_WEBHOOK_PATH=

# --- Central node (Wazuh manager / indexer)
WAZUH_MANAGER_ADDRESS=
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=

# --- Management VPN (WireGuard)
WG_ENDPOINT=
WG_SUBNET=
